{
  "name": "lab-workspace-template",
  "version": "1.0.0",
  "description": "通用實驗課 GitHub 工作區母倉庫 (Template, Agent Skill, Web App, CLI)",
  "private": true,
  "type": "module",
  "scripts": {
    "create-lab": "node scripts/create-lab.mjs",
    "sync-skill": "node scripts/sync-skill.mjs",
    "validate": "node scripts/validate-repo.mjs",
    "test:activity": "tsx scripts/verify-activity-log.mjs",
    "test:auth": "tsx scripts/verify-auth-session.mjs",
    "test:permissions": "tsx scripts/verify-permissions.mjs",
    "test:management": "tsx scripts/verify-management.mjs",
    "test:frontend": "node scripts/verify-frontend.mjs",
    "test:provisioning": "tsx scripts/verify-provisioning.mjs",
    "test:workspace": "tsx scripts/verify-workspace.mjs",
    "test:workspace-api": "tsx scripts/verify-workspace-api.mjs",
    "test:course-mode": "tsx scripts/verify-course-mode.mjs",
    "test:prod": "node scripts/smoke-test-prod.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "keywords": [
    "github-workspace",
    "experiment-template",
    "agent-skill",
    "cloudflare-pages",
    "lab-management"
  ],
  "author": "Lab Workspace System",
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
