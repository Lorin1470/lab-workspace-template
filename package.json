{
  "name": "lab-workspace-template",
  "version": "1.0.0",
  "description": "通用實驗課 GitHub 工作區母倉庫 (Template, Agent Skill, Web App, CLI)",
  "private": true,
  "type": "module",
  "scripts": {
    "create-lab": "node scripts/create-lab.mjs",
    "sync-skill": "node scripts/sync-skill.mjs",
    "validate": "node scripts/validate-repo.mjs",
    "test:activity": "node scripts/verify-activity-log.mjs",
    "test:auth": "node scripts/verify-auth-session.mjs",
    "test:permissions": "node scripts/verify-permissions.mjs",
    "test:management": "node scripts/verify-management.mjs",
    "test:frontend": "node scripts/verify-frontend.mjs",
    "test:provisioning": "node scripts/verify-provisioning.mjs",
    "test:workspace": "node scripts/verify-workspace.mjs",
    "test:prod": "node scripts/smoke-test-prod.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "keywords": [
    "github-workspace",
    "experiment-template",
    "agent-skill",
    "cloudflare-pages",
    "lab-management"
